# Các giá trị bên dưới là mẫu. Không đưa khóa thật vào GitHub.
# Vercel: khai báo trong Settings > Environment Variables, không upload .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Tùy chọn: để trống để nén ngữ cảnh bằng cùng model chính.
DEEPSEEK_SUMMARY_MODEL=
# true: nội dung mẫu có nhãn, không gọi DeepSeek, không phân tích năng lực.
AI_DEMO_MODE=false

# CHỈ LOCAL: SQLite không lưu bền vững trên Vercel.
# Các API AI có chi phí và server guest cần adapter PostgreSQL + migration phù hợp.
# Không dùng /tmp để giả lập lịch sử production. Xem docs/vercel-deploy.md.
DATABASE_URL=sqlite:///data/advisor.sqlite3

# Google Cloud Speech-to-Text: dùng tệp credentials ở ngoài dự án.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase Web: sao chép đúng ứng dụng hiện tại, không tạo/đổi project.
# Backend hiện xác minh token bằng google-auth, không dùng Firebase Admin SDK
# và không cần service-account JSON cho đăng nhập.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=your-firebase-web-app-id
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id

# Shared PostgreSQL protection: requires migration 004, no startup migration.
AI_USER_PER_MINUTE=30
AI_USER_PER_DAY=200
AI_IP_PER_MINUTE=60
AI_IP_PER_DAY=300
AI_GUEST_CREATE_PER_MINUTE=3
AI_GUEST_CREATE_PER_DAY=10
AI_GUEST_TTL_SECONDS=86400
# Empty: trust only ASGI socket peer, NEVER client X-Forwarded-For.
# Configure actual verified ingress CIDRs only; run Uvicorn --no-proxy-headers.
AI_TRUSTED_PROXY_CIDRS=
# Exact public origin for cookie CSRF checks, e.g. https://your-preview.vercel.app
AI_PUBLIC_ORIGIN=

# Optional, backend-only video importer. Does not approve videos automatically.
YOUTUBE_DATA_API_KEY=

# Optional backend search. Chỉ bật trên môi trường đã được kiểm thử.
# ddgs: không cần key; brave: cần SEARCH_API_KEY. Rỗng: không bật Search.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Enable only after migration 006 is verified on the target environment.
ADVISOR_PROFILE_ENABLED=false

# Preview only. No automatic effect on Production; keeps all mutations disabled.
ADVISOR_READ_ONLY_PREVIEW=false
PROFILE_USER_WRITES_PER_MINUTE=30
PROFILE_IP_WRITES_PER_MINUTE=90

# Quyền Hồ sơ thử nghiệm; không giới hạn pipeline AI hội thoại theo UID.
# Empty UID list grants no experimental data access; never client-controlled.
ADVISOR_CONTROLLED_ROLLOUT=true
ADVISOR_TEST_UIDS=


# Tác vụ phân tích khảo sát riêng: không trừ 8 lượt chat khách.
ANALYSIS_USER_PER_DAY=6
ANALYSIS_USER_PER_MINUTE=2
ANALYSIS_IP_PER_DAY=30
ANALYSIS_TIMEOUT_SECONDS=25
