DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# true: nội dung mẫu có nhãn, không gọi DeepSeek, không phân tích năng lực.
AI_DEMO_MODE=false

# Lịch sử local; chỉ lưu cuộc trò chuyện khi người dùng chọn đồng ý.
DATABASE_URL=sqlite:///data/advisor.sqlite3

# Google Cloud Speech-to-Text: dùng tệp credentials ở ngoài dự án.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase Web configuration (Project settings -> Your apps -> Web)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
